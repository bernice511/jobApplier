{
  "manifest_version": 3,
  "name": "jobApplier Assistant",
  "version": "0.1.0",
  "description": "Reads the job you're viewing (LinkedIn, Indeed, Greenhouse, Lever, Workday, or ADP) and tailors your resume/cover letter via your local jobApplier backend.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.myworkdayjobs.com/*",
    "*://myjobs.adp.com/*",
    "http://127.0.0.1:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://myjobs.adp.com/*"
      ],
      "js": ["content.js", "autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "jobApplier - open panel"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}

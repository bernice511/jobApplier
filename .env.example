# --- Job search filters ---
# Comma-separated job titles/keywords to search for
JOB_TITLES=Software Engineer,Backend Engineer

# Semicolon-separated locations (LinkedIn location strings). Use "Remote" as one of them if relevant.
LOCATIONS=Boston, MA;Remote

# Comma-separated LinkedIn seniority filter values, e.g. "Entry level,Associate,Mid-Senior level"
SENIORITY_LEVEL=Entry level,Associate

# --- Safety / rate limiting ---
# Hard cap on number of applications processed in a single run
MAX_APPLICATIONS_PER_RUN=15

# Randomized delay bounds (seconds) between actions/jobs, to look like normal human browsing
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=25

# --- Claude (for resume/cover-letter tailoring) ---
# Uses your existing Claude Code subscription via the `claude` CLI - no API key needed here.
# Just make sure you've run `claude /login` in a terminal on this machine first.

# --- Browser automation ---
# Directory for a DEDICATED persistent browser profile used only by this tool
# (real Chrome browser, not headless - just not your everyday profile, so there's
# no lock conflict if your regular Chrome is already open). You'll log into
# LinkedIn once inside this profile the first time you run the tool, and the
# session will persist across runs after that. Defaults to data/browser_profile
# if left blank.
BROWSER_PROFILE_DIR=

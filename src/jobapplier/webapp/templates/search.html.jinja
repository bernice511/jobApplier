{% extends "base.html.jinja" %}

{% block content %}
<div class="card">
  <h2>Applications</h2>
  <p class="hint">Every resume/cover letter you've generated from a pasted JD, tracked by stage.</p>
  <input id="filter-input" type="text" placeholder="Filter by company, title, location, or tag..."
    style="width:100%; padding:0.6rem 0.9rem; font-size:0.9rem; color:var(--text-1); background:var(--page); border:1px solid var(--border); border-radius:999px; outline:none;">
  <div id="tag-filter-bar" class="chip-row" style="margin-top:0.6rem;"></div>
</div>

<div class="card">
  <div class="status-tabs" id="status-tabs"></div>
  <table class="app-table">
    <thead>
      <tr>
        <th>Company / Title</th>
        <th>Score</th>
        <th>Files</th>
        <th>Tags</th>
        <th>Status</th>
        <th>Applied</th>
      </tr>
    </thead>
    <tbody id="app-table-body"></tbody>
  </table>
  <div id="app-empty" class="hint" style="display:none;">No applications match.</div>
</div>
{% endblock %}

{% block scripts %}
<style>
  .status-tabs { display: flex; gap: 0.4rem; margin-bottom: 0.9rem; flex-wrap: wrap; }
  .status-tab {
    padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid var(--border);
    background: var(--page); color: var(--text-2); font-size: 0.82rem; font-weight: 600;
    cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
  }
  .status-tab .dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
  .status-tab.active { background: var(--accent); color: var(--button-ink); border-color: var(--accent); }
  .status-tab.active .dot { background: var(--button-ink) !important; }
  .status-tab .count { opacity: 0.7; }

  .app-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .app-table th {
    text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em;
    color: var(--text-muted); font-weight: 700; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--border);
  }
  .app-table td { padding: 0.6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .app-table tr:last-child td { border-bottom: none; }
  .app-row-title { font-weight: 600; }
  .app-row-sub { color: var(--text-muted); font-size: 0.78rem; margin-top: 1px; }
  .app-score {
    font-size: 0.75rem; font-weight: 700; padding: 0.1rem 0.5rem; border-radius: 999px; display: inline-block;
  }
  .app-files { display: flex; flex-direction: column; gap: 0.25rem; }
  .app-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; max-width: 160px; }
  .app-tag {
    font-size: 0.7rem; font-weight: 600; padding: 0.1rem 0.45rem; border-radius: 999px;
    background: var(--accent-wash); color: var(--accent); display: inline-flex; align-items: center; gap: 0.25rem;
  }
  .app-tag button { all: unset; cursor: pointer; font-size: 0.75rem; line-height: 1; color: var(--accent); }
  .app-tag-add {
    font-size: 0.7rem; padding: 0.1rem 0.5rem; border-radius: 999px; border: 1px dashed var(--border);
    background: none; color: var(--text-muted); cursor: pointer;
  }
  .app-tag-input {
    font-size: 0.72rem; padding: 0.15rem 0.4rem; border-radius: 6px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text-1); width: 90px;
  }
  .app-status-select {
    font-size: 0.78rem; padding: 0.25rem 0.4rem; border-radius: 6px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text-1);
  }
  .app-applied-date { color: var(--text-muted); font-size: 0.8rem; white-space: nowrap; }
  #tag-filter-bar .chip { cursor: pointer; }
  #tag-filter-bar .chip.active { background: var(--accent); color: var(--button-ink); }
</style>
<script>
  // Order matters for tab display order - must match tailoring_log.STATUSES on the backend.
  const STATUSES = [
    { key: 'saved', label: 'Saved', color: 'var(--text-muted)' },
    { key: 'applied', label: 'Applied', color: 'var(--accent)' },
    { key: 'interview', label: 'Interview', color: 'var(--warning)' },
    { key: 'offer', label: 'Offer', color: 'var(--good)' },
    { key: 'rejected', label: 'Rejected', color: 'var(--critical)' },
  ];
  const STATUS_BY_KEY = Object.fromEntries(STATUSES.map((s) => [s.key, s]));

  const filterInput = document.getElementById('filter-input');
  const tagFilterBar = document.getElementById('tag-filter-bar');
  const statusTabsEl = document.getElementById('status-tabs');
  const tableBody = document.getElementById('app-table-body');
  const appEmpty = document.getElementById('app-empty');
  let allApplications = [];
  let activeTagFilter = null;
  let activeStatusTab = 'all';

  function matchesFilter(record, tokens) {
    if (activeStatusTab !== 'all' && (record.status || 'saved') !== activeStatusTab) return false;
    if (activeTagFilter && !(record.tags || []).includes(activeTagFilter)) return false;
    if (!tokens.length) return true;
    const haystack = `${record.company} ${record.title} ${record.location || ''} ${(record.tags || []).join(' ')}`.toLowerCase();
    return tokens.every((t) => haystack.includes(t));
  }

  function renderTagFilterBar() {
    const allTags = [...new Set(allApplications.flatMap((r) => r.tags || []))].sort();
    tagFilterBar.innerHTML = '';
    allTags.forEach((tag) => {
      const chip = document.createElement('span');
      chip.className = 'chip' + (tag === activeTagFilter ? ' active' : '');
      chip.textContent = tag;
      chip.addEventListener('click', () => {
        activeTagFilter = activeTagFilter === tag ? null : tag;
        renderAll();
      });
      tagFilterBar.appendChild(chip);
    });
  }

  function renderStatusTabs() {
    const counts = { all: allApplications.length };
    STATUSES.forEach(({ key }) => { counts[key] = allApplications.filter((r) => (r.status || 'saved') === key).length; });

    const tabs = [{ key: 'all', label: 'All', color: null }, ...STATUSES];
    statusTabsEl.innerHTML = '';
    tabs.forEach(({ key, label, color }) => {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'status-tab' + (key === activeStatusTab ? ' active' : '');
      tab.innerHTML = `${color ? `<span class="dot" style="background:${color};"></span>` : ''}${label} <span class="count">${counts[key]}</span>`;
      tab.addEventListener('click', () => { activeStatusTab = key; renderAll(); });
      statusTabsEl.appendChild(tab);
    });
  }

  function renderTagsCell(record) {
    const container = document.createElement('div');
    container.className = 'app-tags';
    (record.tags || []).forEach((tag) => {
      const chip = document.createElement('span');
      chip.className = 'app-tag';
      chip.innerHTML = `${tag} <button type="button" title="Remove tag">&times;</button>`;
      chip.querySelector('button').addEventListener('click', () => setTags(record, record.tags.filter((t) => t !== tag)));
      container.appendChild(chip);
    });
    const addBtn = document.createElement('button');
    addBtn.type = 'button';
    addBtn.className = 'app-tag-add';
    addBtn.textContent = '+ tag';
    addBtn.addEventListener('click', () => {
      const input = document.createElement('input');
      input.className = 'app-tag-input';
      input.placeholder = 'tag name';
      addBtn.replaceWith(input);
      input.focus();
      const commit = () => {
        const value = input.value.trim();
        if (value && !(record.tags || []).includes(value)) setTags(record, [...(record.tags || []), value]);
        else renderAll();
      };
      input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter') commit();
        if (ev.key === 'Escape') renderAll();
      });
      input.addEventListener('blur', commit);
    });
    container.appendChild(addBtn);
    return container;
  }

  function renderRow(record) {
    const tr = document.createElement('tr');
    tr.dataset.recordKey = record.record_key;

    const titleTd = document.createElement('td');
    titleTd.innerHTML = `
      <div class="app-row-title">${record.title}</div>
      <div class="app-row-sub">${record.company}${record.location ? ' - ' + record.location : ''}</div>
    `;
    tr.appendChild(titleTd);

    const scoreTd = document.createElement('td');
    const hasScore = record.match_score !== undefined && record.match_score !== null && record.match_score !== '';
    scoreTd.innerHTML = hasScore
      ? `<span class="app-score" style="color:${scoreColor(record.match_score)}; border:1px solid ${scoreColor(record.match_score)};">${record.match_score}/10</span>`
      : '<span class="app-row-sub">—</span>';
    tr.appendChild(scoreTd);

    const filesTd = document.createElement('td');
    filesTd.className = 'app-files';
    let downloads = '';
    if (record.resume_filename) downloads += fileLink(record.resume_filename, 'Resume');
    if (record.cover_letter_filename) downloads += fileLink(record.cover_letter_filename, 'Cover letter');
    filesTd.innerHTML = downloads || '<span class="app-row-sub">—</span>';
    tr.appendChild(filesTd);

    const tagsTd = document.createElement('td');
    tagsTd.appendChild(renderTagsCell(record));
    tr.appendChild(tagsTd);

    const statusTd = document.createElement('td');
    const select = document.createElement('select');
    select.className = 'app-status-select';
    STATUSES.forEach(({ key, label }) => {
      const opt = document.createElement('option');
      opt.value = key;
      opt.textContent = label;
      if (key === (record.status || 'saved')) opt.selected = true;
      select.appendChild(opt);
    });
    select.addEventListener('change', () => setStatus(record, select.value));
    statusTd.appendChild(select);
    tr.appendChild(statusTd);

    const appliedTd = document.createElement('td');
    appliedTd.className = 'app-applied-date';
    appliedTd.textContent = record.date_applied || '—';
    tr.appendChild(appliedTd);

    return tr;
  }

  async function setTags(record, tags) {
    const previous = record.tags;
    record.tags = tags; // optimistic - rendered immediately, rolled back below on failure
    renderAll();
    const resp = await fetch('/api/applications/set_tags', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ record_key: record.record_key, tags }),
    });
    if (!resp.ok) {
      record.tags = previous;
      renderAll();
    }
  }

  async function setStatus(record, status) {
    const previous = record.status;
    record.status = status; // optimistic - rendered immediately, rolled back below on failure
    renderAll();
    const resp = await fetch('/api/applications/set_status', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ record_key: record.record_key, status }),
    });
    if (!resp.ok) {
      record.status = previous;
      renderAll();
    }
  }

  function renderAll() {
    const query = filterInput.value.trim().toLowerCase();
    const tokens = query.split(/\s+/).filter((t) => t.length >= 2);
    const filtered = allApplications
      .filter((r) => matchesFilter(r, tokens))
      .sort((a, b) => (b.timestamp || '').localeCompare(a.timestamp || ''));

    renderTagFilterBar();
    renderStatusTabs();
    appEmpty.style.display = filtered.length ? 'none' : '';
    tableBody.innerHTML = '';
    filtered.forEach((record) => tableBody.appendChild(renderRow(record)));
  }

  filterInput.addEventListener('input', renderAll);

  async function loadApplications() {
    const resp = await fetch('/api/applications');
    const data = await resp.json();
    allApplications = data.applications || [];
    renderAll();
  }

  loadApplications();
</script>
{% endblock %}

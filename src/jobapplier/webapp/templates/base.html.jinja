<!doctype html>
<html lang="en" data-theme="{{ theme }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>jobApplier</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='2' y='1.5' width='15' height='19' rx='3' fill='%239333ea'/%3E%3Cpath d='M5.5 6.5h8M5.5 10h8M5.5 13.5h5' stroke='%23fff' stroke-width='1.5' stroke-linecap='round'/%3E%3Ccircle cx='18' cy='18' r='5.5' fill='%23fff'/%3E%3Cpath d='M15.6 18.1l1.7 1.7 3.1-3.4' stroke='%239333ea' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E">
  <style>
    :root {
      color-scheme: light;
      --page:        #f9f9f7;
      --surface:     #fcfcfb;
      --text-1:      #0b0b0b;
      --text-2:      #52514e;
      --text-muted:  #898781;
      --border:      rgba(11,11,11,0.10);
      --gridline:    #e1e0d9;
      /* Plum brand accent - same hue family as the dark-mode accent below (just a darker,
         more saturated step for the light surface), so the brand color doesn't switch hues
         when the theme flips. 5.11:1 vs this page, 5.38:1 for white button text. */
      --accent:      #9333ea;
      --accent-wash: rgba(147,51,234,0.10);
      --button-ink:  #ffffff;
      /* Status colors are fixed/theme-invariant by design (see dark block below) - a status
         never changes hue when the theme flips, only the shade tuned for that background does.
         These are darkened from the original dark-tuned hues until they clear 4.5:1 against
         the light page background. */
      --good:        #0a820a;
      --warning:     #956703;
      --serious:     #c44717;
      --critical:    #d03b3b;
      --highlight:   #966600;
      --highlight-wash: rgba(150,102,0,0.16);
      --radius: 10px;
      --sidebar-w: 200px;
      --sidebar-w-collapsed: 60px;
      /* Decorative, non-semantic background tints cycled across job-card lists (see
         pastelTint() below) - fixed order, purely for visual variety, never tied to score or
         status (that meaning lives entirely in the ring-badge color). */
      --pastel-1: #E3F3EA;
      --pastel-2: #FBEADB;
      --pastel-3: #F7E3EC;
      --pastel-4: #E8E5F7;
      --pastel-5: #DCEEF7;
      --pastel-6: #FCF3D0;
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      /* Plum & Ink dark palette: ultra-dark teal-black base with a bright violet accent. */
      --page:        #0c1618;
      --surface:     #142226;
      --text-1:      #eaf4f3;
      --text-2:      #b7cbc9;
      --text-muted:  #7e9997;
      --border:      rgba(220,245,240,0.10);
      --gridline:    #203536;
      --accent:      #c084fc;
      --accent-wash: rgba(192,132,252,0.16);
      /* This violet is bright - white text on it is only 2.64:1 (WCAG fail). Dark ink
         gives much better contrast, so buttons use the page color as their text instead
         of white in dark mode specifically. */
      --button-ink:  var(--page);
      --good:        #0ca30c;
      --warning:     #fab219;
      --serious:     #ec835a;
      --critical:    #d03b3b;
      --highlight:   #f5c26b;
      --highlight-wash: rgba(245,194,107,0.24);
      --pastel-1: #16332a;
      --pastel-2: #3a2c1c;
      --pastel-3: #3a2430;
      --pastel-4: #2a2740;
      --pastel-5: #1c2f3a;
      --pastel-6: #3a3320;
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--page);
      color: var(--text-1);
      line-height: 1.45;
    }

    .shell { display: flex; min-height: 100vh; }

    /* --- Sidebar --- */
    .sidebar {
      flex: none;
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      padding: 0.9rem 0.6rem;
      transition: width 0.15s ease;
    }
    body.sidebar-collapsed .sidebar { width: var(--sidebar-w-collapsed); padding: 0.9rem 0.4rem; }

    .sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; margin-bottom: 1.1rem; padding: 0 0.3rem; }
    .brand { display: flex; align-items: center; gap: 0.5rem; overflow: hidden; }
    .brand svg { flex: none; }
    .brand-name { font-size: 1.02rem; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
    body.sidebar-collapsed .brand-name { display: none; }

    .collapse-btn {
      flex: none; width: 24px; height: 24px; padding: 0; border: none; border-radius: 6px;
      background: transparent; color: var(--text-muted); cursor: pointer;
      display: flex; align-items: center; justify-content: center; transition: background 0.15s;
    }
    .collapse-btn:hover { background: var(--gridline); color: var(--text-1); }
    .collapse-btn svg { transition: transform 0.15s ease; }
    body.sidebar-collapsed .collapse-btn svg { transform: rotate(180deg); }

    .side-nav { display: flex; flex-direction: column; gap: 0.15rem; }
    .side-nav a {
      display: flex; align-items: center; gap: 0.65rem;
      padding: 0.5rem 0.6rem; border-radius: 8px;
      text-decoration: none; color: var(--text-2); font-size: 0.87rem; font-weight: 600;
      white-space: nowrap; overflow: hidden;
    }
    .side-nav a svg { flex: none; }
    .side-nav a .label { overflow: hidden; text-overflow: ellipsis; }
    body.sidebar-collapsed .side-nav a .label { display: none; }
    body.sidebar-collapsed .side-nav a { justify-content: center; }
    .side-nav a:hover { background: var(--gridline); color: var(--text-1); }
    .side-nav a.active { background: var(--accent-wash); color: var(--accent); }

    /* --- Main content --- */
    .main { flex: 1; min-width: 0; padding: 1.6rem 2rem 3.5rem; max-width: 1400px; }
    .app-subtitle { color: var(--text-2); font-size: 0.88rem; margin: 0 0 1.3rem; }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.15rem;
      margin-bottom: 1.1rem;
      box-shadow: 0 1px 2px rgba(11,11,11,0.04);
    }
    .card h2 { font-size: 1rem; font-weight: 600; margin: 0 0 0.2rem; }
    .card > p.hint { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 0.8rem; }

    textarea {
      width: 100%; min-height: 200px; resize: vertical;
      font-family: inherit; font-size: 0.92rem; color: var(--text-1);
      background: var(--page); border: 1px solid var(--border); border-radius: 8px;
      padding: 0.75rem; outline: none; transition: border-color 0.15s;
    }
    textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }

    .chip-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.3rem 0 0.2rem; }
    .chip {
      font-size: 0.8rem; padding: 0.25rem 0.7rem; border-radius: 999px;
      background: var(--gridline); color: var(--text-2);
    }
    .keyword-option {
      display: flex; align-items: flex-start; gap: 0.6rem;
      padding: 0.55rem 0.7rem; border: 1px solid var(--border); border-radius: 8px;
      margin-bottom: 0.5rem; cursor: pointer;
    }
    .keyword-option:hover { border-color: var(--accent); }
    .keyword-option input { margin-top: 0.2rem; accent-color: var(--accent); cursor: pointer; }
    .keyword-term { font-weight: 600; font-size: 0.88rem; }
    .keyword-basis { display: block; color: var(--text-muted); font-size: 0.8rem; margin-top: 2px; }

    .radio-group {
      display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 0.9rem;
      font-size: 0.85rem; color: var(--text-2);
    }
    .radio-group label { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
    .radio-group input[type="radio"] { accent-color: var(--accent); cursor: pointer; }

    button.primary {
      margin-top: 0.85rem; padding: 0.55rem 1.3rem; font-size: 0.9rem; font-weight: 600;
      color: var(--button-ink); background: var(--accent); border: none; border-radius: 8px;
      cursor: pointer; transition: filter 0.15s, transform 0.05s;
    }
    button.primary:hover { filter: brightness(1.08); }
    button.primary:active { transform: scale(0.98); }
    button.primary:disabled { opacity: 0.55; cursor: default; }

    .loading-box {
      margin-top: 1rem; padding: 1.4rem 1rem; display: flex; flex-direction: column;
      align-items: center; gap: 0.6rem; color: var(--text-2); font-size: 0.85rem;
    }
    .spinner-lg {
      width: 28px; height: 28px; border-radius: 50%;
      border: 3px solid var(--gridline); border-top-color: var(--accent);
      animation: spin 0.7s linear infinite;
    }
    .spinner {
      width: 14px; height: 14px; border-radius: 50%;
      border: 2px solid var(--gridline); border-top-color: var(--accent);
      animation: spin 0.7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .error-box {
      margin-top: 0.9rem; padding: 0.7rem 0.9rem; border-radius: 8px;
      background: rgba(208,59,59,0.10); color: var(--critical); font-size: 0.88rem;
    }

    .duplicate-notice {
      margin-top: 0.9rem; padding: 0.7rem 0.9rem; border-radius: 8px;
      background: var(--accent-wash); color: var(--accent); font-size: 0.88rem;
    }

    /* Result panel */
    .result-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 0.4rem; flex-wrap: wrap; }
    .result-title { font-weight: 700; font-size: 1.05rem; }
    .result-sub { color: var(--text-muted); font-size: 0.85rem; }

    .stat-row { display: flex; align-items: center; gap: 1rem; margin: 0.8rem 0; }
    .stat-tile { flex: none; }
    .stat-label { font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
    .stat-value { font-size: 1.7rem; font-weight: 700; line-height: 1; }
    .stat-value .stat-value-sub { font-size: 1rem; font-weight: 500; color: var(--text-muted); }
    .meter-track { flex: 1; height: 8px; border-radius: 4px; background: var(--gridline); overflow: hidden; min-width: 120px; }
    .meter-fill { height: 100%; border-radius: 4px; transition: width 0.4s ease; }

    .downloads { display: flex; gap: 0.6rem; margin-top: 0.2rem; }
    .pill-link {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-size: 0.85rem; font-weight: 600; text-decoration: none;
      color: var(--accent); background: var(--accent-wash);
      padding: 0.4rem 0.85rem; border-radius: 999px; transition: filter 0.15s;
    }
    .pill-link:hover { filter: brightness(0.97); }

    button.secondary {
      padding: 0.4rem 0.85rem; font-size: 0.85rem; font-weight: 600;
      color: var(--text-2); background: var(--gridline); border: none; border-radius: 999px;
      cursor: pointer; transition: filter 0.15s;
    }
    button.secondary:hover { filter: brightness(0.94); }
    body.sidebar-collapsed .side-nav a.active { position: relative; }

    .changes-title { font-size: 0.85rem; font-weight: 600; margin: 0.9rem 0 0.4rem; color: var(--text-2); }
    .changes-list { list-style: none; margin: 0; padding: 0; }
    .changes-list li { position: relative; padding-left: 1.1rem; margin-bottom: 0.4rem; font-size: 0.87rem; color: var(--text-2); }
    .changes-list li::before {
      content: ""; position: absolute; left: 0; top: 0.5em;
      width: 5px; height: 5px; border-radius: 50%; background: var(--accent);
    }

    .preview-note { font-size: 0.8rem; color: var(--text-muted); margin: 1rem 0 0.5rem; }
    .preview-box {
      border: 1px solid var(--border); border-radius: 8px; padding: 1.1rem 1.3rem;
      background: var(--page); max-height: 480px; overflow-y: auto;
    }

    /* Chat */
    #chat-log { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.9rem; }
    #chat-log:empty { display: none; }
    .bubble-user {
      align-self: flex-end; max-width: 85%;
      background: var(--accent); color: var(--button-ink);
      padding: 0.55rem 0.9rem; border-radius: 14px 14px 3px 14px;
      font-size: 0.9rem;
    }
    .bubble-empty { align-self: flex-start; color: var(--text-muted); font-size: 0.87rem; padding: 0.2rem 0.2rem; }
    .result-card {
      align-self: flex-start; max-width: 100%; width: 100%;
      border: 1px solid var(--border); border-radius: 10px; padding: 0.7rem 0.9rem;
      background: var(--page);
    }
    .result-card .meta { font-weight: 600; font-size: 0.92rem; }
    .result-card .sub { color: var(--text-muted); font-size: 0.8rem; margin-top: 1px; }
    .result-card .downloads { margin-top: 0.5rem; }

    .chat-input-row { display: flex; gap: 0.5rem; }
    .chat-input-row input {
      flex: 1; padding: 0.6rem 0.9rem; font-size: 0.9rem; color: var(--text-1);
      background: var(--page); border: 1px solid var(--border); border-radius: 999px;
      outline: none; transition: border-color 0.15s;
    }
    .chat-input-row input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-wash); }

    /* Pagination (used on /alerts) */
    .pagination { display: flex; align-items: center; justify-content: center; gap: 0.3rem; margin-top: 1rem; }
    .pagination button {
      min-width: 30px; height: 30px; padding: 0 0.5rem; border: 1px solid var(--border);
      border-radius: 6px; background: var(--surface); color: var(--text-2);
      font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: filter 0.15s;
    }
    .pagination button:hover:not(:disabled) { filter: brightness(0.95); }
    .pagination button:disabled { opacity: 0.4; cursor: default; }
    .pagination button.active { background: var(--accent); color: var(--button-ink); border-color: var(--accent); }

    /* Job-list cards (alerts) - a rotating pastel background (set inline per card, see
       pastelTint()) with the match score as a floating ring badge, matching the browse-jobs
       card grid reference. */
    .job-card {
      display: flex; flex-direction: column;
      border-radius: 16px; padding: 1rem 1.1rem 0.9rem;
      margin-bottom: 0.9rem;
    }
    .job-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.9rem; }
    .job-card-main { flex: 1; min-width: 0; }
    .job-card-main .meta { font-weight: 700; font-size: 0.95rem; color: var(--text-1); }
    .job-card-main .sub { color: var(--text-2); opacity: 0.75; font-size: 0.8rem; margin: 2px 0 0.6rem; }
    .job-card-main .downloads { margin-top: 0.7rem; display: flex; gap: 0.5rem; }
    .job-card-main .chip-row { margin: 0 0 0.2rem; }
    .job-card-main .chip { background: rgba(255,255,255,0.55); }
    :root[data-theme="dark"] .job-card-main .chip { background: rgba(255,255,255,0.08); }
    .job-card-score {
      flex: none; width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--accent);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; background: rgba(255,255,255,0.55);
    }
    :root[data-theme="dark"] .job-card-score { background: rgba(255,255,255,0.06); }
    .job-card-score-value { font-size: 0.9rem; font-weight: 700; line-height: 1; }
    .job-card-score-value .job-card-score-sub { font-size: 0.6rem; font-weight: 500; opacity: 0.7; }
    .job-card-score-label { font-size: 0.5rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; }
    .job-card-actions { display: flex; gap: 0.5rem; margin-top: 0.9rem; }
    .job-card-actions .pill-link, .job-card-actions button.secondary { flex: 1; justify-content: center; }
    .job-card-actions button.secondary { background: rgba(255,255,255,0.6); color: var(--text-1); }
    :root[data-theme="dark"] .job-card-actions button.secondary { background: rgba(255,255,255,0.08); color: var(--text-1); }
  </style>
</head>
<body>
  <div class="shell">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-top">
        <div class="brand">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="1.5" width="15" height="19" rx="3" fill="var(--accent)"/>
            <path d="M5.5 6.5h8M5.5 10h8M5.5 13.5h5" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="18" cy="18" r="5.5" fill="var(--surface)"/>
            <path d="M15.6 18.1l1.7 1.7 3.1-3.4" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="brand-name">jobApplier</span>
        </div>
        <button class="collapse-btn" id="collapse-btn" title="Collapse sidebar" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6"/>
          </svg>
        </button>
      </div>

      <nav class="side-nav">
        <a href="/alerts" class="{{ 'active' if active_page == 'alerts' else '' }}" title="Job Alerts">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9a6 6 0 0 1 12 0c0 4 1.5 5.5 2 6.5H4c.5-1 2-2.5 2-6.5z"/><path d="M10 19a2 2 0 0 0 4 0"/></svg>
          <span class="label">Job Alerts</span>
        </a>
        <a href="/search" class="{{ 'active' if active_page == 'search' else '' }}" title="Applications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <span class="label">Applications</span>
        </a>
        <a href="/analytics" class="{{ 'active' if active_page == 'analytics' else '' }}" title="Analytics">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M12 20V4M20 20v-7"/></svg>
          <span class="label">Analytics</span>
        </a>
        <a href="/resume" class="{{ 'active' if active_page == 'resume' else '' }}" title="Resume">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9.5 13h5M9.5 16.5h5"/></svg>
          <span class="label">Resume</span>
        </a>
        <a href="/profile" class="{{ 'active' if active_page == 'profile' else '' }}" title="Profile">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
          <span class="label">Profile</span>
        </a>
        <a href="/" class="{{ 'active' if active_page == 'tailor' else '' }}" title="Tailor">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"/></svg>
          <span class="label">Tailor</span>
        </a>
      </nav>
    </aside>

    <main class="main">
      {% block content %}{% endblock %}
    </main>
  </div>

  <script>
    const SIDEBAR_KEY = 'jobapplier.sidebarCollapsed';
    if (localStorage.getItem(SIDEBAR_KEY) === '1') document.body.classList.add('sidebar-collapsed');
    document.getElementById('collapse-btn').addEventListener('click', () => {
      const collapsed = document.body.classList.toggle('sidebar-collapsed');
      localStorage.setItem(SIDEBAR_KEY, collapsed ? '1' : '0');
    });

    function scoreColor(score) {
      if (score >= 8) return 'var(--good)';
      if (score >= 6) return 'var(--warning)';
      if (score >= 4) return 'var(--serious)';
      return 'var(--critical)';
    }

    function fileLink(filename, label) {
      return `<a class="pill-link" href="/files/${encodeURIComponent(filename)}" target="_blank">${label}</a>`;
    }

    function statTileHtml(score) {
      if (score === undefined || score === null || score === '') return '';
      const color = scoreColor(score);
      const pct = Math.max(0, Math.min(10, score)) * 10;
      return `
        <div class="stat-row">
          <div class="stat-tile">
            <div class="stat-label">Match score</div>
            <div class="stat-value">${score}<span class="stat-value-sub">/10</span></div>
          </div>
          <div class="meter-track"><div class="meter-fill" style="width:${pct}%; background:${color};"></div></div>
        </div>
      `;
    }

    function matchLabel(score) {
      if (score >= 8) return 'STRONG MATCH';
      if (score >= 6) return 'GOOD MATCH';
      if (score >= 4) return 'FAIR MATCH';
      return 'WEAK MATCH';
    }

    // Used by job-list cards (alerts) instead of statTileHtml() - a floating ring badge meant
    // to sit in the corner of a pastel card, not a bar inside it.
    function matchScorePanelHtml(score) {
      if (score === undefined || score === null || score === '') return '';
      const color = scoreColor(score);
      return `
        <div class="job-card-score" style="border-color:${color};">
          <div class="job-card-score-value">${score}<span class="job-card-score-sub">/10</span></div>
          <div class="job-card-score-label" style="color:${color};">${matchLabel(score)}</div>
        </div>
      `;
    }

    // Decorative, non-semantic background cycled across job-card lists - fixed order, never
    // tied to score/status (see --pastel-N tokens above).
    function pastelTint(index) {
      return `var(--pastel-${(index % 6) + 1})`;
    }

    function renderResultCard(r) {
      const div = document.createElement('div');
      div.className = 'result-card';
      let downloads = '';
      if (r.resume_filename) downloads += fileLink(r.resume_filename, 'Resume');
      if (r.cover_letter_filename) downloads += fileLink(r.cover_letter_filename, 'Cover letter');
      div.innerHTML = `
        <div class="meta">${r.title} @ ${r.company}${r.location ? ' - ' + r.location : ''}</div>
        <div class="sub">${r.timestamp || ''}</div>
        ${statTileHtml(r.match_score)}
        <div class="downloads">
          ${downloads}
        </div>
      `;
      return div;
    }

    // Shared by tailor.html.jinja and resume.html.jinja for a running "Xs" progress caption.
    function startLoading(container, label) {
      let seconds = 0;
      const captionId = container.id + '-caption';
      container.innerHTML = `
        <div class="loading-box">
          <div class="spinner-lg"></div>
          <div id="${captionId}">${label}</div>
        </div>
      `;
      const caption = document.getElementById(captionId);
      return setInterval(() => {
        seconds += 1;
        if (caption) caption.textContent = `${label} ${seconds}s`;
      }, 1000);
    }
  </script>
  {% block scripts %}{% endblock %}
</body>
</html>

{% extends "base.html.jinja" %}

{% block content %}
<div class="card">
  <h2>Analytics</h2>
  <p class="hint">Computed from your Applications log - nothing here needs a network call
    beyond the one that already powers the Applications board.</p>
  <div id="hero-stats" class="hero-stats"></div>
</div>

<div class="card">
  <h2>Pipeline funnel</h2>
  <p class="hint">How many applications are sitting at each stage right now.</p>
  <div id="funnel-chart"></div>
</div>

<div class="card">
  <h2>Applications per week</h2>
  <p class="hint">Last 8 weeks, by when you generated the resume/cover letter.</p>
  <div id="weekly-chart" class="weekly-chart"></div>
</div>

<div class="card">
  <h2>By source</h2>
  <p class="hint">Which board each application came from.</p>
  <div id="source-chart"></div>
</div>
{% endblock %}

{% block scripts %}
<style>
  .hero-stats { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.6rem; }
  .hero-stat { flex: 1; min-width: 140px; background: var(--page); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem; }
  .hero-stat .value { font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
  .hero-stat .label { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.2rem; }

  .bar-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.55rem; font-size: 0.85rem; }
  .bar-label { flex: 0 0 110px; color: var(--text-2); }
  .bar-track { flex: 1; background: var(--page); border-radius: 999px; height: 14px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 999px; min-width: 3px; transition: width 0.2s; }
  .bar-value { flex: 0 0 30px; text-align: right; color: var(--text-muted); font-size: 0.8rem; }

  .weekly-chart { display: flex; align-items: flex-end; gap: 0.6rem; height: 140px; padding-top: 0.5rem; }
  .weekly-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
  .weekly-bar { width: 100%; max-width: 34px; background: var(--accent); border-radius: 4px 4px 0 0; min-height: 2px; }
  .weekly-count { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.2rem; }
  .weekly-label { font-size: 0.68rem; color: var(--text-muted); margin-top: 0.3rem; text-align: center; }

  .empty-note { color: var(--text-muted); font-size: 0.85rem; }
</style>
<script>
  // Same stage colors the Kanban board and match-score badges already use elsewhere - no new
  // color decisions here, just reusing what's already established (good=offer, critical=
  // rejected, warning=interview since it's the "still uncertain" stage, neutral for the
  // stages that haven't reached a real outcome yet).
  const STAGE_COLORS = {
    saved: 'var(--text-muted)',
    applied: 'var(--accent)',
    interview: 'var(--warning)',
    offer: 'var(--good)',
    rejected: 'var(--critical)',
  };
  const STAGE_LABELS = { saved: 'Saved', applied: 'Applied', interview: 'Interview', offer: 'Offer', rejected: 'Rejected' };

  function renderHeroStats(records) {
    const total = records.length;
    const beyondSaved = records.filter((r) => r.status !== 'saved');
    const interviewOrBetter = records.filter((r) => r.status === 'interview' || r.status === 'offer');
    const offers = records.filter((r) => r.status === 'offer').length;
    const interviewRate = beyondSaved.length ? Math.round((interviewOrBetter.length / beyondSaved.length) * 100) : 0;

    const stats = [
      { value: total, label: 'Total applications tracked' },
      { value: beyondSaved.length, label: 'Actually applied' },
      { value: `${interviewRate}%`, label: 'Reached interview or better' },
      { value: offers, label: 'Offers' },
    ];
    document.getElementById('hero-stats').innerHTML = stats
      .map((s) => `<div class="hero-stat"><div class="value">${s.value}</div><div class="label">${s.label}</div></div>`)
      .join('');
  }

  function renderFunnel(records) {
    const el = document.getElementById('funnel-chart');
    const counts = {};
    Object.keys(STAGE_LABELS).forEach((k) => { counts[k] = 0; });
    records.forEach((r) => { counts[r.status] = (counts[r.status] || 0) + 1; });
    const max = Math.max(1, ...Object.values(counts));

    el.innerHTML = Object.keys(STAGE_LABELS).map((key) => `
      <div class="bar-row">
        <div class="bar-label">${STAGE_LABELS[key]}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(counts[key] / max) * 100}%; background:${STAGE_COLORS[key]};"></div></div>
        <div class="bar-value">${counts[key]}</div>
      </div>
    `).join('');
  }

  function isoWeekStart(dateStr) {
    const d = new Date(dateStr);
    if (isNaN(d)) return null;
    const day = d.getDay();
    const diff = (day === 0 ? -6 : 1) - day; // back up to Monday
    d.setDate(d.getDate() + diff);
    d.setHours(0, 0, 0, 0);
    return d;
  }

  function renderWeekly(records) {
    const el = document.getElementById('weekly-chart');
    const WEEKS = 8;
    const now = new Date();
    const thisWeekStart = isoWeekStart(now.toISOString());

    const buckets = [];
    for (let i = WEEKS - 1; i >= 0; i--) {
      const start = new Date(thisWeekStart);
      start.setDate(start.getDate() - i * 7);
      buckets.push({ start, count: 0 });
    }

    records.forEach((r) => {
      const weekStart = isoWeekStart(r.timestamp);
      if (!weekStart) return;
      const bucket = buckets.find((b) => b.start.getTime() === weekStart.getTime());
      if (bucket) bucket.count++;
    });

    const max = Math.max(1, ...buckets.map((b) => b.count));
    el.innerHTML = buckets.map((b) => `
      <div class="weekly-col">
        <div class="weekly-count">${b.count || ''}</div>
        <div class="weekly-bar" style="height:${(b.count / max) * 100}%;"></div>
        <div class="weekly-label">${b.start.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}</div>
      </div>
    `).join('');
  }

  function renderSource(records) {
    const el = document.getElementById('source-chart');
    const counts = {};
    records.forEach((r) => {
      const key = r.source || 'Unknown';
      counts[key] = (counts[key] || 0) + 1;
    });
    const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
    if (!entries.length) {
      el.innerHTML = '<p class="empty-note">No applications yet.</p>';
      return;
    }
    const max = Math.max(1, ...entries.map(([, c]) => c));
    el.innerHTML = entries.map(([label, count]) => `
      <div class="bar-row">
        <div class="bar-label">${label}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(count / max) * 100}%; background:var(--accent);"></div></div>
        <div class="bar-value">${count}</div>
      </div>
    `).join('');
  }

  async function loadAnalytics() {
    const resp = await fetch('/api/applications');
    const data = await resp.json();
    const records = data.applications || [];
    renderHeroStats(records);
    renderFunnel(records);
    renderWeekly(records);
    renderSource(records);
  }

  loadAnalytics();
</script>
{% endblock %}

<div class="resume-preview">
  <style>
    .resume-preview { font-family: Georgia, "Times New Roman", Times, serif; font-size: 13px; line-height: 1.35; }
    .resume-preview .header { text-align: center; margin-bottom: 6px; }
    .resume-preview .name { font-size: 20px; font-weight: bold; }
    .resume-preview .contact { font-size: 12px; opacity: 0.8; }
    .resume-preview .section-title {
      font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;
      border-bottom: 1px solid currentColor; margin-top: 10px; margin-bottom: 4px; padding-bottom: 2px;
    }
    .resume-preview .row { display: flex; justify-content: space-between; }
    .resume-preview .row-bold { font-weight: bold; }
    .resume-preview .row-italic { font-style: italic; }
    .resume-preview ul.bullets { margin: 3px 0 0 0; padding-left: 18px; }
    .resume-preview ul.bullets li { margin-bottom: 2px; }
    .resume-preview .subentry { margin-top: 4px; }
    .resume-preview mark.changed {
      background: rgba(237,161,0,0.20); border-bottom: 2px solid #eda100;
      color: inherit; padding: 0 2px; border-radius: 2px;
    }
    /* Text identical to the master resume is lower-priority to review than what actually
       changed - dimming it (rather than leaving it at full weight like the highlighted
       edits) means the eye lands on the edits first instead of having to hunt for the
       highlight color among a wall of same-weight text. */
    .resume-preview .unchanged { opacity: 0.45; }
    @media (prefers-color-scheme: dark) {
      .resume-preview mark.changed { background: rgba(201,133,0,0.28); border-bottom-color: #c98500; }
    }
  </style>

  {% macro segs(segments) %}{% for seg in segments %}{% if seg.changed %}<mark class="changed">{{ seg.text }}</mark>{% else %}<span class="unchanged">{{ seg.text }}</span>{% endif %}{% endfor %}{% endmacro %}

  <div class="header">
    <div class="name">{{ name }}</div>
    <div class="contact">{{ contact | join(' | ') }}</div>
  </div>

  {% for section in sections %}
  <div class="section-title">{{ section.title }}</div>

  {% if section.type == 'paragraph' %}
    <p>{{ segs(section.content.segments) }}</p>

  {% elif section.type == 'skills' %}
    {% for cat in section.categories %}
    <p><strong>{{ cat.name }}:</strong> {{ cat['items'] | join(', ') }}</p>
    {% endfor %}

  {% elif section.type == 'entries' %}
    {% for e in section.entries %}
    <div class="entry">
      <div class="row row-bold">
        <span>{{ e.header_left_bold }}{% if e.header_left_normal %} | {{ e.header_left_normal }}{% endif %}</span>
        <span>{{ e.header_right }}</span>
      </div>
      {% if e.two_line %}
      <div class="row row-italic">
        <span>{{ e.sub_left }}</span>
        <span>{{ e.sub_right }}</span>
      </div>
      {% endif %}
      {% if e.bullets %}
      <ul class="bullets">
        {% for b in e.bullets %}
        <li>{{ segs(b.segments) }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% for sub in e.subentries %}
      <div class="subentry">
        <div class="row row-italic">
          <span><strong>{{ sub.header_left_bold }}</strong></span>
          <span>{{ sub.header_right }}</span>
        </div>
        <ul class="bullets">
          {% for b in sub.bullets %}
          <li>{{ segs(b.segments) }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  {% endif %}
  {% endfor %}
</div>

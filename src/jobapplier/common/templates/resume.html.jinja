<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page {
    size: Letter;
    margin: {{ style.margin_top_in }}in {{ style.margin_right_in }}in
            {{ style.margin_bottom_in }}in {{ style.margin_left_in }}in;
  }
  * { box-sizing: border-box; }
  body {
    font-family: {{ style.body_font_family }};
    font-size: {{ style.body_font_size_pt }}pt;
    line-height: {{ style.line_height }};
    color: {{ style.text_color }};
  }
  .header { text-align: center; margin-bottom: 3pt; }
  .header-with-photo {
    display: flex;
    align-items: center;
    gap: 10pt;
    text-align: center;
    margin-bottom: 3pt;
    flex-direction: {{ 'row-reverse' if style.photo_side == 'right' else 'row' }};
  }
  .header-with-photo .header-text { flex: 1; }
  .photo {
    width: {{ style.photo_width_pt }}pt;
    height: {{ style.photo_height_pt }}pt;
    object-fit: cover;
    border-radius: 3pt;
    flex-shrink: 0;
  }
  .name {
    font-size: {{ style.name_font_size_pt }}pt;
    font-weight: bold;
    letter-spacing: 0.5pt;
    color: {{ style.name_color }};
  }
  .tagline { font-size: {{ style.body_font_size_pt + 0.5 }}pt; margin-top: 0pt; color: {{ style.name_color }}; }
  .contact { font-size: {{ style.body_font_size_pt - 0.5 }}pt; margin-top: 0pt; color: {{ style.contact_color }}; }
  .contact a { color: {{ style.contact_color }}; text-decoration: none; }
  .section-title {
    font-size: {{ style.section_title_font_size_pt }}pt;
    font-weight: {{ 'bold' if style.section_title_bold else 'normal' }};
    text-transform: {{ 'uppercase' if style.section_title_uppercase else 'none' }};
    letter-spacing: 0.5pt;
    color: {{ style.section_title_color }};
    {% if style.section_title_underline -%}
    border-bottom: 0.75pt solid {{ style.text_color }};
    {%- endif %}
    margin-top: 4pt;
    margin-bottom: 2pt;
    padding-bottom: 0.5pt;
  }
  .paragraph { margin: 0 0 1pt 0; text-align: justify; }
  .entry { margin-bottom: 2pt; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .row > span:first-child { flex: 1; padding-right: 8pt; }
  .row > span:last-child { white-space: nowrap; text-align: right; }
  .row-bold { font-weight: bold; }
  .row-italic { font-style: italic; }
  .header-left-bold { font-weight: bold; }
  .header-left-normal { font-weight: normal; }
  ul.bullets { margin: 1pt 0 0 0; padding-left: 12pt; }
  ul.bullets li { margin-bottom: 0.5pt; text-align: justify; }
  .subentry { margin-top: 1.5pt; margin-left: 0pt; }
  .subentry .row { font-style: italic; }
  .subentry .sub-name { font-weight: bold; font-style: normal; }
  .skills p { margin: 1pt 0; }
  .skills .skill-cat { font-weight: bold; }
</style>
</head>
<body>
  {% if style.photo_data_uri %}
  <div class="header-with-photo">
    <img class="photo" src="{{ style.photo_data_uri }}" alt="">
    <div class="header-text">
      <div class="name">{{ name }}</div>
      {% if tagline %}<div class="tagline">{{ tagline }}</div>{% endif %}
      <div class="contact">{{ contact | join(' | ') }}</div>
    </div>
  </div>
  {% else %}
  <div class="header">
    <div class="name">{{ name }}</div>
    {% if tagline %}<div class="tagline">{{ tagline }}</div>{% endif %}
    <div class="contact">{{ contact | join(' | ') }}</div>
  </div>
  {% endif %}

  {% for section in sections %}
  <div class="section-title">{{ section.title }}</div>

  {% if section.type == 'paragraph' %}
    <p class="paragraph">{{ section.content }}</p>

  {% elif section.type == 'skills' %}
    <div class="skills">
      {% for cat in section.categories %}
      <p><span class="skill-cat">{{ cat.name }}:</span> {{ cat['items'] | join(', ') }}</p>
      {% endfor %}
    </div>

  {% elif section.type == 'entries' %}
    {% for e in section.entries %}
    <div class="entry">
      <div class="row row-bold">
        <span>{{ e.header_left_bold }}{% if e.header_left_normal %} <span class="header-left-normal">| {{ e.header_left_normal }}</span>{% endif %}</span>
        <span>{{ e.header_right }}</span>
      </div>
      {% if e.two_line %}
      <div class="row row-italic">
        <span>{{ e.sub_left }}</span>
        <span>{{ e.sub_right }}</span>
      </div>
      {% endif %}
      {% if e.bullets %}
      <ul class="bullets">
        {% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% for sub in e.subentries %}
      <div class="subentry">
        <div class="row">
          <span class="sub-name">{{ sub.header_left_bold }}</span>
          <span>{{ sub.header_right }}</span>
        </div>
        <ul class="bullets">
          {% for b in sub.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  {% endif %}
  {% endfor %}
</body>
</html>
